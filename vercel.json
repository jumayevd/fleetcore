{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && if [ \"$VERCEL_ENV\" = \"production\" ]; then prisma migrate deploy; fi && next build",
  "ignoreCommand": "[ \"$VERCEL_ENV\" != \"production\" ]",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/eld",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 3 * * *"
    }
  ]
}
