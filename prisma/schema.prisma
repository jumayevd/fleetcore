// FleetCore data model.
// Postgres (Neon via the Vercel Marketplace). DATABASE_URL is the pooled
// connection for the app; DATABASE_URL_UNPOOLED is used for migrations.
// Status/role fields are strings; allowed values live in src/lib/constants.ts.
//
// Accounts and companies: a User is a sign-in identity (email + password). A Company is one fleet's workspace and owns
// every operational row (companyId). A Membership gives a user a role in a company, so one person can work for several
// companies, and a browser can hold several signed-in users at once. src/lib/db.ts scopes every query on a company
// model to the company that is active for the request; rootDb (unscoped) is only for accounts and memberships.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Accounts
 */
/**
 * ------------------------------------------------------------------
 */

model User {
  id                 String               @id @default(cuid())
  /// Display name: first and last name together.
  name               String
  email              String               @unique
  passwordHash       String
  phone              String?
  /// Personal details, asked of everyone who joins a company by invitation (src/lib/profile.ts).
  firstName          String?
  lastName           String?
  /// Passport, national ID or employee number, as written.
  idNumber           String?
  birthDate          DateTime?            @db.Date
  /// "OWNER": runs FleetCore itself (the Platform console, every company), without being a member of any. Set by an
  /// operator only (src/lib/platform.ts).
  platformRole       String?
  /// May create new companies (set by an operator for the platform owner's team). Platform owners always may.
  canCreateCompanies Boolean              @default(false)
  passwordLinks      PasswordLink[]
  active             Boolean              @default(true)
  /// Sign-ins older than this no longer count (set when the password changes, so other browsers are signed out).
  sessionsValidFrom  DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime             @default(now())
  memberships        Membership[]
  invitesSent        Invite[]
  workOrders         WorkOrder[]
  documents          Document[]
  audits             AuditLog[]
  woEvents           WorkOrderEvent[]
  walkReviews        WalkAround[]
  defectsOwned       Defect[]             @relation("DefectOwner")
  defectsClosed      Defect[]             @relation("DefectCloser")
  roadside           RoadsideInspection[]
  assignmentsMade    DriverAssignment[]   @relation("AssignmentCreator")
  assignmentsEnded   DriverAssignment[]   @relation("AssignmentEnder")
}

/// One fleet's workspace. Everything a fleet specialist works with belongs to exactly one company.
model Company {
  id          String               @id @default(cuid())
  name        String
  /// Hex colour of the workspace badge, so it is obvious which company you are working in.
  color       String?
  /// "imperial" (mi, gal, MPG, lb) or "metric" (km, L, L/100 km, kg). Every distance, volume and weight stored for this
  /// company is in its own system: fields named …Km / …L / …Kg hold miles / gallons / pounds for an imperial company.
  units       String               @default("imperial")
  /// IANA time zone the company works in. Dates and times show in it; the viewer's own clock is shown next to it.
  timezone    String               @default("America/New_York")
  currency    String               @default("USD")
  createdAt   DateTime             @default(now())
  truckTypes  TruckType[]
  vendors     Vendor[]
  woLines     WorkOrderLine[]
  woEvents    WorkOrderEvent[]
  walkArounds WalkAround[]
  walkRatings WalkAroundRating[]
  defects     Defect[]
  roadside    RoadsideInspection[]
  violations  RoadsideViolation[]
  eldLinks    EldConnection[]
  eldUnits    EldUnit[]
  assignments DriverAssignment[]
  memberships Membership[]
  invites     Invite[]
  drivers     Driver[]
  trucks      Truck[]
  trailers    Trailer[]
  workOrders  WorkOrder[]
  fuelLogs    FuelLog[]
  documents   Document[]
  audits      AuditLog[]
  settings    AppSetting[]
}

model Membership {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// OWNER | ADMIN | SPECIALIST | VIEWER
  role         String    @default("SPECIALIST")
  active       Boolean   @default(true)
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
}

/// A one-time link to set an account's password: a new account made by an operator, or a forgotten password (there is
/// no email). Only a hash of the token is kept.
model PasswordLink {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  /// Who made it (a platform owner), or null for an operator script.
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

/// Wrong passwords on the sign-in form, per email ("email:…") and per IP address ("ip:…"), so every server instance
/// counts the same (src/lib/login-throttle.ts). Times with a zone: they are compared in SQL.
model LoginThrottle {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime  @db.Timestamptz(3)
  lockedUntil DateTime? @db.Timestamptz(3)
}

/// A link that lets someone join a company. Accepted by a signed-in account with the same email.
model Invite {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  /// OWNER | ADMIN | SPECIALIST | VIEWER
  role        String    @default("SPECIALIST")
  token       String    @unique
  invitedById String?
  invitedBy   User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId])
  @@index([email])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Fleet
 */
/**
 * ------------------------------------------------------------------
 */

model Driver {
  id            String               @id @default(cuid())
  companyId     String               @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  phone2        String?
  email         String?
  licenseNumber String
  licenseClass  String               @default("CE")
  licenseExpiry DateTime
  medicalExpiry DateTime?
  /// Employment: ACTIVE | ON_LEAVE | INACTIVE
  status        String               @default("ACTIVE")
  /// COMPANY | OWNER_OPERATOR | LEASE
  type          String               @default("COMPANY")
  /// Kept off the road (safety or paperwork) until released.
  hold          Boolean              @default(false)
  holdReason    String?
  /// Safety score, 0–100.
  score         Int                  @default(100)
  hireDate      DateTime             @default(now())
  /// Who dispatches this driver (a name or a team), so PTI videos and repairs can be chased with the right person.
  dispatcher    String?
  notes         String?
  createdAt     DateTime             @default(now())
  truck         Truck?               @relation("TruckDriver")
  fuelLogs      FuelLog[]
  documents     Document[]
  charges       WorkOrder[]          @relation("WorkOrderDriverCharge")
  walkArounds   WalkAround[]
  roadside      RoadsideInspection[]
  assignments   DriverAssignment[]

  @@index([companyId])
}

model Truck {
  id                 String               @id @default(cuid())
  companyId          String               @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unitNumber         String
  make               String
  model              String
  year               Int
  vin                String?
  plate              String
  /// ACTIVE (Available, or Assigned with a driver) | MAINTENANCE (In shop: a repair order has it) | OUT_OF_SERVICE
  /// (held by a "fix before next load" defect) | INACTIVE
  status             String               @default("ACTIVE")
  /// A vendor's truck: belongs to another company or owner (not leased). Set by hand; the truck keeps its own status.
  isVendor           Boolean              @default(false)
  /// Why it is Inactive (INACTIVE_REASONS), with any details, and when the status started.
  statusReason       String?
  statusNote         String?
  statusSince        DateTime?
  /// COMPANY | OWNER_OPERATOR | LEASED
  ownership          String               @default("COMPANY")
  group              String? // fleet group / terminal label
  lessor             String?
  leaseStartKm       Int?
  leaseAnnualLimitKm Int?
  leaseBufferPct     Float?
  leaseOverageRate   Float? // currency per km over the cap
  odometerKm         Int                  @default(0)
  fuelType           String               @default("DIESEL")
  fuelCapacityL      Int                  @default(600)
  insuranceExpiry    DateTime?
  inspectionExpiry   DateTime?
  registrationExpiry DateTime?
  pmIntervalKm       Int                  @default(30000)
  lastPmKm           Int?
  lastPmAt           DateTime?
  nextServiceKm      Int?
  /// Where this truck goes for its oil change: a shop name or an address, as the specialist types it on the oil board.
  oilShop            String?
  // Last known telemetry
  lat                Float?
  lng                Float?
  speedKmh           Float?
  heading            Float?
  fuelPct            Float?
  engineOn           Boolean?
  fuelEconomy        Float? // rolling, in the company's economy unit (MPG imperial, L/100 km metric)
  locationName       String?
  lastPingAt         DateTime?
  pingSource         String? // MANUAL | DEVICE | SAMSARA | …
  driverId           String?              @unique
  driver             Driver?              @relation("TruckDriver", fields: [driverId], references: [id], onDelete: SetNull)
  /// The type sets the oil-change interval (pmIntervalKm is the truck's own interval when it has no type).
  truckTypeId        String?
  truckType          TruckType?           @relation(fields: [truckTypeId], references: [id], onDelete: SetNull)
  /// When the odometer above was read. A stale reading makes "due" figures lower bounds.
  odometerAt         DateTime?
  inServiceAt        DateTime?
  homeTerminal       String?
  color              String?
  engineHours        Int?
  notes              String?
  createdAt          DateTime             @default(now())
  workOrders         WorkOrder[]
  fuelLogs           FuelLog[]
  documents          Document[]
  trailers           Trailer[]
  walkArounds        WalkAround[]
  defects            Defect[]
  roadside           RoadsideInspection[]
  eldUnits           EldUnit[]
  assignments        DriverAssignment[]

  @@unique([companyId, unitNumber])
  @@index([companyId, status])
}

model Trailer {
  id               String               @id @default(cuid())
  companyId        String               @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unitNumber       String
  type             String // DRY_VAN | REEFER | FLATBED | TANKER | CONTAINER
  capacityKg       Int
  plate            String?
  year             Int?
  /// IN_USE | EMPTY | DROPPED | YARD | SHOP | OUT_OF_SERVICE
  status           String               @default("EMPTY")
  statusSince      DateTime             @default(now())
  truckId          String? // currently paired tractor
  truck            Truck?               @relation(fields: [truckId], references: [id], onDelete: SetNull)
  lat              Float?
  lng              Float?
  locationName     String?
  gpsProvider      String?
  lastPingAt       DateTime?
  insuranceExpiry  DateTime?
  inspectionExpiry DateTime?
  notes            String?
  createdAt        DateTime             @default(now())
  documents        Document[]
  workOrders       WorkOrder[]
  defects          Defect[]
  roadside         RoadsideInspection[]

  @@unique([companyId, unitNumber])
  @@index([companyId, status])
}

/// Shop work: PM, repairs, inspections. Numbered per company (#1, #2, …).
model WorkOrder {
  id               String           @id @default(cuid())
  companyId        String           @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number           Int
  truckId          String?
  truck            Truck?           @relation(fields: [truckId], references: [id], onDelete: Cascade)
  trailerId        String?
  trailer          Trailer?         @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  /// PM | ENGINE | COOLING | TIRES | BRAKES | ELECTRICAL | BODY | TOWING | INSPECTION | OTHER
  category         String           @default("OTHER")
  /// LOW | MEDIUM | HIGH | URGENT
  priority         String           @default("MEDIUM")
  /// DRAFT | OPEN | IN_PROGRESS | DONE | CANCELLED
  status           String           @default("OPEN")
  vendor           String?
  scheduledAt      DateTime
  inAt             DateTime? // unit entered the shop
  outAt            DateTime? // unit left the shop
  completedAt      DateTime?
  odometerKm       Int?
  laborCost        Float            @default(0)
  partsCost        Float            @default(0)
  cost             Float            @default(0)
  notes            String?
  /// OIL_CHANGE | DOT_INSPECTION | PM_INSPECTION | REPAIR | ENGINE | ELECTRICAL | FRAME | BODY | STEER | DPF | INJECTOR | COMPUTER | ACCIDENT | TIRES | OTHER
  repairType       String           @default("REPAIR")
  /// Where a job in the shop has got to: DIAGNOSING | WAITING_APPROVAL | WAITING_PARTS | IN_REPAIR | QUALITY_CHECK | READY_PICKUP
  stage            String?
  stageAt          DateTime?
  /// The date the shop promised the unit back.
  promisedAt       DateTime?
  odometerOutKm    Int?
  technician       String?
  vendorId         String?
  vendorRef        Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// Who pays: COMPANY | DRIVER (charged to chargeDriverId) | INVESTIGATION (held) | WARRANTY (claimed back)
  payer            String           @default("COMPANY")
  chargeDriverId   String?
  chargeDriver     Driver?          @relation("WorkOrderDriverCharge", fields: [chargeDriverId], references: [id], onDelete: SetNull)
  /// Nothing comes off a driver's pay until they have been told.
  driverInformedAt DateTime?
  invoiceNumber    String?
  invoiceTotal     Float?
  /// PAID | PAY_LATER
  paymentStatus    String?
  voidedAt         DateTime?
  voidReason       String?
  createdById      String?
  createdBy        User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  documents        Document[]
  lines            WorkOrderLine[]
  events           WorkOrderEvent[]
  defects          Defect[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([truckId])
}

model FuelLog {
  id         String   @id @default(cuid())
  companyId  String   @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  truckId    String
  truck      Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  liters     Float
  cost       Float
  odometerKm Int?
  station    String?
  date       DateTime @default(now())

  @@index([companyId, date])
  @@index([truckId, date])
}

/// Files attached to trucks, trailers, drivers, work orders, or the company itself.
/// Bytes live in Vercel Blob (prod) or ./storage (local dev).
model Document {
  id           String              @id @default(cuid())
  companyId    String              @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind         String
  name         String
  storageKey   String              @unique
  contentType  String
  size         Int
  expiresAt    DateTime?
  notes        String?
  isCompany    Boolean             @default(false)
  truckId      String?
  truck        Truck?              @relation(fields: [truckId], references: [id], onDelete: Cascade)
  trailerId    String?
  trailer      Trailer?            @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  driverId     String?
  driver       Driver?             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  workOrderId  String?
  workOrder    WorkOrder?          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  roadsideId   String?
  roadside     RoadsideInspection? @relation(fields: [roadsideId], references: [id], onDelete: Cascade)
  /// Pickup photos of a driver assignment (the unit as the driver took it).
  assignmentId String?
  assignment   DriverAssignment?   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// When the paper was issued (annual inspection, registration…), next to expiresAt.
  issuedAt     DateTime?
  uploadedById String?
  uploadedBy   User?               @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())

  @@index([companyId])
  @@index([truckId])
  @@index([trailerId])
  @@index([driverId])
  @@index([workOrderId])
  @@index([roadsideId])
  @@index([assignmentId])
}

/// Who drove a truck, from when to when (src/lib/assignments.ts). The open row (endedAt null) is the current driver and
/// matches Truck.driverId; every change of driver closes it and opens the next, so a truck keeps its whole history.
/// Days are company calendar days (midnight in the company's time zone), like the other date fields.
model DriverAssignment {
  id          String     @id @default(cuid())
  companyId   String     @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  truckId     String
  truck       Truck      @relation(fields: [truckId], references: [id], onDelete: Cascade)
  driverId    String
  driver      Driver     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  /// The day the driver took the unit.
  startedAt   DateTime
  /// The day the driver gave it back (or moved to another truck); null while they still drive it.
  endedAt     DateTime?
  /// Made from an assignment that existed before history was kept: the start is the best guess (last assign, or the
  /// truck's creation).
  backfilled  Boolean    @default(false)
  /// What went with the unit: [{ item: "TABLET" | … | "OTHER", label?: "Jack", ref?: "SN 12345" }] (src/lib/handover.ts).
  handover    Json       @default("[]")
  note        String?
  /// Why or how it ended (returned keys, damage found…).
  endNote     String?
  createdById String?
  createdBy   User?      @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  endedById   String?
  endedBy     User?      @relation("AssignmentEnder", fields: [endedById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  documents   Document[]

  @@index([companyId, truckId])
  @@index([driverId])
}

model AuditLog {
  id        String   @id @default(cuid())
  /// Null for account-level events that belong to no company.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

/// Small per-company key/value store for runtime settings (company profile JSON).
model AppSetting {
  id        String   @id @default(cuid())
  companyId String   @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Shop
 */
/**
 * ------------------------------------------------------------------
 */

/// A kind of truck with its own oil-change interval (in the company's distance unit).
model TruckType {
  id            String   @id @default(cuid())
  companyId     String   @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  oilIntervalKm Int
  createdAt     DateTime @default(now())
  trucks        Truck[]

  @@unique([companyId, name])
}

/// A shop, dealer, tire service, road-side service or parts supplier the fleet uses.
model Vendor {
  id          String      @id @default(cuid())
  companyId   String      @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  /// DEALER | SHOP | TIRE | MOBILE | TOWING | PARTS | OTHER
  type        String      @default("SHOP")
  phone       String?
  email       String?
  address     String?
  city        String?
  contactName String?
  notes       String?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  workOrders  WorkOrder[]

  @@unique([companyId, name])
}

/// One line of "what was done" on a repair order: the system, the work and what it cost.
model WorkOrderLine {
  id          String    @id @default(cuid())
  companyId   String    @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  /// BODY | BRAKES | ELECTRICAL | TIRES | ENGINE | COOLING | EXHAUST | HVAC | SUSPENSION | PM | FEES | OTHER
  system      String
  work        String
  amount      Float     @default(0)
  position    Int       @default(0)

  @@index([workOrderId])
}

/// The repair order's timeline: stage changes, notes, "driver told", invoice.
model WorkOrderEvent {
  id          String    @id @default(cuid())
  companyId   String    @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  /// STAGE | NOTE | STATUS | DRIVER_INFORMED | INVOICE | VOID
  kind        String
  stage       String?
  body        String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([workOrderId, createdAt])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Inspections
 */
/**
 * ------------------------------------------------------------------
 */

/// The weekly pre-trip walk-around of one truck: did the video come, what did the reviewer see.
model WalkAround {
  id           String             @id @default(cuid())
  companyId    String             @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  truckId      String
  truck        Truck              @relation(fields: [truckId], references: [id], onDelete: Cascade)
  driverId     String?
  driver       Driver?            @relation(fields: [driverId], references: [id], onDelete: SetNull)
  /// First day of the week, as a calendar date in the company's time zone.
  weekStart    DateTime           @db.Date
  /// AWAITING | RECEIVED | MISSING
  video        String             @default("AWAITING")
  receivedAt   DateTime?
  /// CLEAN | ISSUES (set when reviewed)
  result       String?
  reviewedById String?
  reviewedBy   User?              @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  notes        String?
  createdAt    DateTime           @default(now())
  ratings      WalkAroundRating[]
  defects      Defect[]

  @@unique([truckId, weekStart])
  @@index([companyId, weekStart])
}

/// One component's rating on a walk-around. A rating carries forward until the component is rated again.
model WalkAroundRating {
  id           String     @id @default(cuid())
  companyId    String     @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  walkAroundId String
  walkAround   WalkAround @relation(fields: [walkAroundId], references: [id], onDelete: Cascade)
  /// One of PTI_COMPONENTS in src/lib/constants.ts
  component    String
  /// GOOD | SOON | NOW | UNSEEN
  rating       String

  @@unique([walkAroundId, component])
}

/// Something wrong with a unit, found on a walk-around or reported. Numbered per company (DEF-0001…).
/// A NOW defect takes the truck out of service until someone verifies the repair.
model Defect {
  id           String      @id @default(cuid())
  companyId    String      @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number       Int
  truckId      String?
  truck        Truck?      @relation(fields: [truckId], references: [id], onDelete: Cascade)
  trailerId    String?
  trailer      Trailer?    @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  walkAroundId String?
  walkAround   WalkAround? @relation(fields: [walkAroundId], references: [id], onDelete: SetNull)
  component    String
  description  String
  /// NOW (before the next load) | SOON (within 2 weeks) | WATCH
  severity     String
  /// OPEN | REPAIRED (waiting for someone to confirm) | CLOSED
  status       String      @default("OPEN")
  /// True while this defect keeps the truck out of service.
  holdsUnit    Boolean     @default(false)
  foundAt      DateTime    @default(now())
  dueAt        DateTime?
  ownerId      String?
  owner        User?       @relation("DefectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  workOrderId  String?
  workOrder    WorkOrder?  @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  repairedAt   DateTime?
  closedAt     DateTime?
  closedById   String?
  closedBy     User?       @relation("DefectCloser", fields: [closedById], references: [id], onDelete: SetNull)
  closeNote    String?
  createdAt    DateTime    @default(now())

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([truckId])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Safety & compliance
 */
/**
 * ------------------------------------------------------------------
 */

/// A roadside (DOT) inspection report and what has to be corrected.
model RoadsideInspection {
  id              String              @id @default(cuid())
  companyId       String              @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inspectedAt     DateTime
  reportNumber    String?
  /// Inspection level 1–6
  level           Int                 @default(1)
  state           String?
  location        String?
  driverId        String?
  driver          Driver?             @relation(fields: [driverId], references: [id], onDelete: SetNull)
  truckId         String?
  truck           Truck?              @relation(fields: [truckId], references: [id], onDelete: SetNull)
  trailerId       String?
  trailer         Trailer?            @relation(fields: [trailerId], references: [id], onDelete: SetNull)
  /// CLEAN | VIOLATIONS | OOS
  result          String              @default("CLEAN")
  correctionDueAt DateTime?
  /// OPEN | CORRECTED | CLOSED
  status          String              @default("OPEN")
  notes           String?
  createdById     String?
  createdBy       User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  violations      RoadsideViolation[]
  documents       Document[]

  @@index([companyId, inspectedAt])
}

model RoadsideViolation {
  id           String             @id @default(cuid())
  companyId    String             @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inspectionId String
  inspection   RoadsideInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  code         String?
  description  String
  /// DRIVER | TRUCK | TRAILER
  unit         String             @default("TRUCK")
  oos          Boolean            @default(false)
  correctedAt  DateTime?

  @@index([inspectionId])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * ELD integrations
 */
/**
 * ------------------------------------------------------------------
 */

/// A company's connection to its ELD provider (TrackPro). The API token is stored encrypted (src/lib/secret-box.ts) and
/// never shown again; tokenHint is its last characters, so people can tell which one is saved.
model EldConnection {
  id            String    @id @default(cuid())
  companyId     String    @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// TRACKPRO
  provider      String
  tokenEnc      String
  tokenHint     String
  /// How the provider's timestamps read: AUTO (worked out on the first sync), UTC, or COMPANY (the company's time zone).
  timeBasis     String    @default("AUTO")
  active        Boolean   @default(true)
  /// When a sync last started (also the lock that keeps two syncs of one company from running at once).
  lastSyncAt    DateTime?
  lastSuccessAt DateTime?
  lastError     String?
  vehicles      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  units         EldUnit[]

  @@unique([companyId, provider])
}

/// One vehicle as the ELD reports it, and the FleetCore truck it belongs to. Keeps the last fix, so the next sync can
/// work out speed and distance (the TrackPro API gives position, fuel and DEF, but no speed or odometer).
model EldUnit {
  id           String        @id @default(cuid())
  companyId    String        @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectionId String
  connection   EldConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// The provider's own vehicle id.
  externalId   String
  unitNumber   String?
  vin          String?
  make         String?
  model        String?
  driverName   String?
  truckId      String?
  truck        Truck?        @relation(fields: [truckId], references: [id], onDelete: SetNull)
  /// AUTO: matched by VIN, else unit number, on every sync. MANUAL: someone picked the truck (or "none") by hand.
  matchMode    String        @default("AUTO")
  lat          Float?
  lng          Float?
  fixAt        DateTime?
  place        String?
  fuelPct      Float?
  defPct       Float?
  /// Worked out from the last two fixes, in the company's unit (mph / km/h). Null when the fixes are too far apart.
  speed        Float?
  /// Straight-line distance between fixes since the truck's last odometer reading (company unit): a lower bound of
  /// what it drove. Starts again from 0 whenever the truck gets a new reading (gpsFrom = that reading's time).
  gpsDistance  Float         @default(0)
  gpsFrom      DateTime?
  seenAt       DateTime      @default(now())
  createdAt    DateTime      @default(now())

  @@unique([connectionId, externalId])
  @@index([companyId])
  @@index([truckId])
}
