// FleetCore data model.
// Postgres (Neon via the Vercel Marketplace). DATABASE_URL is the pooled
// connection for the app; DATABASE_URL_UNPOOLED is used for migrations.
// Status/role fields are strings; allowed values live in src/lib/constants.ts.
//
// Accounts and companies: a User is a sign-in identity (email + password). A Company is one fleet's workspace and owns
// every operational row (companyId). A Membership gives a user a role in a company, so one person can work for several
// companies, and a browser can hold several signed-in users at once. src/lib/db.ts scopes every query on a company
// model to the company that is active for the request; rootDb (unscoped) is only for accounts and memberships.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Accounts
 */
/**
 * ------------------------------------------------------------------
 */

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  phone        String?
  active       Boolean      @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  invitesSent  Invite[]
  workOrders   WorkOrder[]
  documents    Document[]
  audits       AuditLog[]
}

/// One fleet's workspace. Everything a fleet specialist works with belongs to exactly one company.
model Company {
  id          String       @id @default(cuid())
  name        String
  /// Hex colour of the workspace badge, so it is obvious which company you are working in.
  color       String?
  createdAt   DateTime     @default(now())
  memberships Membership[]
  invites     Invite[]
  drivers     Driver[]
  trucks      Truck[]
  trailers    Trailer[]
  workOrders  WorkOrder[]
  fuelLogs    FuelLog[]
  documents   Document[]
  audits      AuditLog[]
  settings    AppSetting[]
}

model Membership {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// OWNER | ADMIN | SPECIALIST | VIEWER
  role         String    @default("SPECIALIST")
  active       Boolean   @default(true)
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
}

/// A link that lets someone join a company. Accepted by a signed-in account with the same email.
model Invite {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  /// OWNER | ADMIN | SPECIALIST | VIEWER
  role        String    @default("SPECIALIST")
  token       String    @unique
  invitedById String?
  invitedBy   User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([companyId])
  @@index([email])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Fleet
 */
/**
 * ------------------------------------------------------------------
 */

model Driver {
  id            String     @id @default(cuid())
  companyId     String     @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  phone2        String?
  email         String?
  licenseNumber String
  licenseClass  String     @default("CE")
  licenseExpiry DateTime
  medicalExpiry DateTime?
  /// Employment: ACTIVE | ON_LEAVE | INACTIVE
  status        String     @default("ACTIVE")
  /// COMPANY | OWNER_OPERATOR | LEASE
  type          String     @default("COMPANY")
  /// Kept off the road (safety or paperwork) until released.
  hold          Boolean    @default(false)
  holdReason    String?
  /// Safety score, 0–100.
  score         Int        @default(100)
  hireDate      DateTime   @default(now())
  notes         String?
  createdAt     DateTime   @default(now())
  truck         Truck?     @relation("TruckDriver")
  fuelLogs      FuelLog[]
  documents     Document[]

  @@index([companyId])
}

model Truck {
  id                 String      @id @default(cuid())
  companyId          String      @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company            Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unitNumber         String
  make               String
  model              String
  year               Int
  vin                String?
  plate              String
  /// ACTIVE | MAINTENANCE | OUT_OF_SERVICE | INACTIVE
  status             String      @default("ACTIVE")
  /// COMPANY | OWNER_OPERATOR | LEASED
  ownership          String      @default("COMPANY")
  group              String? // fleet group / terminal label
  lessor             String?
  leaseStartKm       Int?
  leaseAnnualLimitKm Int?
  leaseBufferPct     Float?
  leaseOverageRate   Float? // currency per km over the cap
  odometerKm         Int         @default(0)
  fuelType           String      @default("DIESEL")
  fuelCapacityL      Int         @default(600)
  insuranceExpiry    DateTime?
  inspectionExpiry   DateTime?
  registrationExpiry DateTime?
  pmIntervalKm       Int         @default(30000)
  lastPmKm           Int?
  lastPmAt           DateTime?
  nextServiceKm      Int?
  // Last known telemetry
  lat                Float?
  lng                Float?
  speedKmh           Float?
  heading            Float?
  fuelPct            Float?
  engineOn           Boolean?
  fuelEconomy        Float? // L/100km, rolling
  locationName       String?
  lastPingAt         DateTime?
  pingSource         String? // MANUAL | DEVICE | SAMSARA | …
  driverId           String?     @unique
  driver             Driver?     @relation("TruckDriver", fields: [driverId], references: [id], onDelete: SetNull)
  notes              String?
  createdAt          DateTime    @default(now())
  workOrders         WorkOrder[]
  fuelLogs           FuelLog[]
  documents          Document[]
  trailers           Trailer[]

  @@unique([companyId, unitNumber])
  @@index([companyId, status])
}

model Trailer {
  id               String      @id @default(cuid())
  companyId        String      @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  unitNumber       String
  type             String // DRY_VAN | REEFER | FLATBED | TANKER | CONTAINER
  capacityKg       Int
  plate            String?
  year             Int?
  /// IN_USE | EMPTY | DROPPED | YARD | SHOP | OUT_OF_SERVICE
  status           String      @default("EMPTY")
  statusSince      DateTime    @default(now())
  truckId          String? // currently paired tractor
  truck            Truck?      @relation(fields: [truckId], references: [id], onDelete: SetNull)
  lat              Float?
  lng              Float?
  locationName     String?
  gpsProvider      String?
  lastPingAt       DateTime?
  insuranceExpiry  DateTime?
  inspectionExpiry DateTime?
  notes            String?
  createdAt        DateTime    @default(now())
  documents        Document[]
  workOrders       WorkOrder[]

  @@unique([companyId, unitNumber])
  @@index([companyId, status])
}

/// Shop work: PM, repairs, inspections. Numbered per company (#1, #2, …).
model WorkOrder {
  id          String     @id @default(cuid())
  companyId   String     @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number      Int
  truckId     String?
  truck       Truck?     @relation(fields: [truckId], references: [id], onDelete: Cascade)
  trailerId   String?
  trailer     Trailer?   @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// PM | ENGINE | COOLING | TIRES | BRAKES | ELECTRICAL | BODY | TOWING | INSPECTION | OTHER
  category    String     @default("OTHER")
  /// LOW | MEDIUM | HIGH | URGENT
  priority    String     @default("MEDIUM")
  /// DRAFT | OPEN | IN_PROGRESS | DONE | CANCELLED
  status      String     @default("OPEN")
  vendor      String?
  scheduledAt DateTime
  inAt        DateTime? // unit entered the shop
  outAt       DateTime? // unit left the shop
  completedAt DateTime?
  odometerKm  Int?
  laborCost   Float      @default(0)
  partsCost   Float      @default(0)
  cost        Float      @default(0)
  notes       String?
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([truckId])
}

model FuelLog {
  id         String   @id @default(cuid())
  companyId  String   @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  truckId    String
  truck      Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  liters     Float
  cost       Float
  odometerKm Int?
  station    String?
  date       DateTime @default(now())

  @@index([companyId, date])
  @@index([truckId, date])
}

/// Files attached to trucks, trailers, drivers, work orders, or the company itself.
/// Bytes live in Vercel Blob (prod) or ./storage (local dev).
model Document {
  id           String     @id @default(cuid())
  companyId    String     @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind         String
  name         String
  storageKey   String     @unique
  contentType  String
  size         Int
  expiresAt    DateTime?
  notes        String?
  isCompany    Boolean    @default(false)
  truckId      String?
  truck        Truck?     @relation(fields: [truckId], references: [id], onDelete: Cascade)
  trailerId    String?
  trailer      Trailer?   @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  driverId     String?
  driver       Driver?    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  workOrderId  String?
  workOrder    WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([companyId])
  @@index([truckId])
  @@index([trailerId])
  @@index([driverId])
  @@index([workOrderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  /// Null for account-level events that belong to no company.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

/// Small per-company key/value store for runtime settings (company profile JSON).
model AppSetting {
  id        String   @id @default(cuid())
  companyId String   @default("") // set by the company scope (src/lib/db.ts); "" fails the foreign key
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
}
