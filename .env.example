# Copy to .env.local for local development (npm run setup creates the local database).

# Postgres. Locally: the cluster started by scripts/dev-db.mjs on port 5434.
# On Vercel: set automatically by the Neon integration of THIS project (not the full platform's database).
DATABASE_URL="postgresql://postgres@localhost:5434/fleetops_fleet"
DATABASE_URL_UNPOOLED="postgresql://postgres@localhost:5434/fleetops_fleet"

# Vercel Blob (private). Leave unset to store uploads in ./storage locally.
BLOB_READ_WRITE_TOKEN=""

# Random 32-byte hex: openssl rand -hex 32. Signs the session cookies; changing it signs everyone out.
AUTH_SECRET=""

# Shows one-click demo logins on the sign-in page. Never enable in production.
DEMO_MODE="false"

# Optional: base URL used in invitation links (defaults to the host the page was opened on)
# APP_URL="https://fleetcore.vercel.app"

# Optional: fleet assistant (Vercel AI Gateway; OIDC works automatically on Vercel)
# AI_GATEWAY_API_KEY=""
# ASSISTANT_MODEL="anthropic/claude-sonnet-5.5"

# Optional: map tiles (defaults to OpenStreetMap)
# NEXT_PUBLIC_MAP_TILE_URL="https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=YOUR_KEY"
