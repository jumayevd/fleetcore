# Copy to .env.local, or run `npm run setup` to pull real values from Vercel.

# Neon Postgres (set automatically by the Vercel Neon integration)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Vercel Blob (private). Leave unset to store uploads in ./storage locally.
BLOB_READ_WRITE_TOKEN=""

# Random 32-byte hex: openssl rand -hex 32
AUTH_SECRET=""
CRON_SECRET=""

# Shows one-click demo logins on the login page. Never enable in production.
DEMO_MODE="false"

# Optional: Telegram alerts (token from @BotFather)
TELEGRAM_BOT_TOKEN=""

# Optional: base URL for links in alerts (defaults to the Vercel production domain)
# APP_URL="https://fleetops-ochre.vercel.app"

# Optional: map tiles (defaults to OpenStreetMap)
# NEXT_PUBLIC_MAP_TILE_URL="https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=YOUR_KEY"
